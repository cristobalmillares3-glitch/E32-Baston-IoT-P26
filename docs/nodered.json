[{"id":"e32a000000000001","type":"tab","label":"E32 · baston P26","disabled":false,"info":"Flujo GT6 del equipo E32 (proyecto P26, baston).\nLectura: curso/E32/P26/nodo1 -> json -> debug + interfaz.\nComando: ON/OFF (inject o botones) -> curso/E32/P26/nodo1/cmd.\nPENDIENTE al importar: elegir la conexion al broker YA CONFIGURADA en 'datos de mi nodo' y '/cmd QoS 1'."},{"id":"e32a000000000002","type":"comment","z":"e32a000000000001","name":"E32 / P26: al importar, elegir la conexion al broker compartida en los dos nodos mqtt","info":"","x":330,"y":20,"wires":[]},{"id":"e32a000000000010","type":"mqtt in","z":"e32a000000000001","name":"datos del baston","topic":"curso/E32/P26/nodo1","qos":"1","datatype":"utf8","broker":"e0452e0e7721cc00","nl":false,"rap":true,"rh":0,"inputs":0,"x":150,"y":100,"wires":[["e32a000000000011"]]},{"id":"e32a000000000011","type":"json","z":"e32a000000000001","name":"a objeto","property":"payload","action":"obj","pretty":false,"x":340,"y":100,"wires":[["e32a000000000012","e32a000000000020"]]},{"id":"e32a000000000012","type":"debug","z":"e32a000000000001","name":"datos","active":true,"tosidebar":true,"console":false,"tostatus":true,"complete":"payload","targetType":"msg","statusVal":"payload.estado","statusType":"msg","x":520,"y":60,"wires":[]},{"id":"e32a000000000020","type":"function","z":"e32a000000000001","name":"preparar interfaz","func":"// Prepara la interfaz a partir del JSON que publica el baston (E32 / P26).\n// ESTADOS en el MISMO orden que el enum Estado del sketch (el numero viaja en \"estado\").\nconst CAMPO   = \"distancia_cm\";\nconst ESTADOS = [\"REPOSO\", \"OBSTACULO_LEJOS\", \"OBSTACULO_CERCA\", \"ERROR_SEGURO\", \"ACTUANDO_REMOTO\"];\n\nconst p = msg.payload;\nif (!p || typeof p !== \"object\") { return null; }\n\nlet medidor = null, serie = null, estado = null;\n// distancia_cm se omite cuando no hay eco o hay error: en ese caso no se actualiza el medidor\nif (typeof p[CAMPO] === \"number\") {\n    medidor = { payload: p[CAMPO] };\n    serie   = { topic: CAMPO, payload: p[CAMPO] };\n}\nif (typeof p.estado === \"number\") {\n    estado = { payload: (ESTADOS[p.estado] || (\"estado \" + p.estado)) + (p.sin_eco === 1 ? \" · sin eco (camino libre)\" : \"\") };\n}\nreturn [medidor, serie, estado];","outputs":3,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":540,"y":140,"wires":[["e32a000000000021"],["e32a000000000022"],["e32a000000000023"]]},{"id":"e32a000000000021","type":"ui-gauge","z":"e32a000000000001","name":"","group":"e32a0000000000a1","order":1,"value":"payload","valueType":"msg","width":4,"height":3,"gtype":"gauge-half","gstyle":"needle","title":"Distancia al obstaculo","alwaysShowTitle":false,"floatingTitlePosition":"top-left","units":"cm","icon":"","prefix":"","suffix":"","segments":[{"color":"#EA5353","from":0},{"color":"#FFC800","from":90},{"color":"#5CD65C","from":170}],"min":0,"max":300,"sizeThickness":16,"sizeGap":4,"sizeKeyThickness":8,"styleRounded":true,"styleGlow":false,"className":"","x":760,"y":100,"wires":[[]]},{"id":"e32a000000000022","type":"ui-chart","z":"e32a000000000001","group":"e32a0000000000a2","name":"","label":"Últimos 30 minutos","order":1,"chartType":"line","category":"topic","categoryType":"msg","xAxisLabel":"","xAxisProperty":null,"xAxisPropertyType":"timestamp","xAxisType":"time","xAxisFormat":"","xAxisFormatType":"auto","xmin":"","xmax":"","yAxisLabel":"cm","yAxisProperty":"payload","yAxisPropertyType":"msg","ymin":"0","ymax":"300","bins":10,"action":"append","stackSeries":false,"pointShape":"circle","pointRadius":2,"showLegend":true,"removeOlder":30,"removeOlderUnit":"60","removeOlderPoints":"","colors":["#0095FF","#FF0000","#FF7F0E","#2CA02C","#A347E1","#D62728","#FF9896","#9467BD","#C5B0D5"],"textColor":["#666666"],"textColorDefault":true,"gridColor":["#e5e5e5"],"gridColorDefault":true,"width":8,"height":5,"className":"","interpolation":"linear","x":760,"y":140,"wires":[[]]},{"id":"e32a000000000023","type":"ui-text","z":"e32a000000